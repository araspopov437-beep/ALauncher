# updater.py
import sys
import os
import json
import urllib.request
import tempfile
import subprocess
import shutil
import zipfile

CURRENT_VERSION = "1.0.0"
UPDATE_URL = "https://alauncher-khaki.vercel.app/update.json"  # Ваш URL для проверки обновлений

def check_for_updates():
    """Проверяет наличие обновлений"""
    try:
        import ssl
        ssl._create_default_https_context = ssl._create_unverified_context
        
        req = urllib.request.Request(UPDATE_URL, headers={'User-Agent': 'ALauncher-Updater/1.0'})
        with urllib.request.urlopen(req, timeout=10) as response:
            update_info = json.loads(response.read().decode('utf-8'))
            latest_version = update_info.get("version", CURRENT_VERSION)
            download_url = update_info.get("download_url", "")
            changelog = update_info.get("changelog", "")
            
            if latest_version > CURRENT_VERSION:
                return True, latest_version, download_url, changelog
    except Exception as e:
        print(f"Ошибка проверки обновлений: {e}")
    
    return False, CURRENT_VERSION, "", ""

def download_update(download_url, progress_callback=None):
    """Скачивает обновление"""
    try:
        temp_dir = tempfile.mkdtemp()
        update_zip = os.path.join(temp_dir, "update.zip")
        
        import ssl
        ssl._create_default_https_context = ssl._create_unverified_context
        
        req = urllib.request.Request(download_url, headers={'User-Agent': 'ALauncher-Updater/1.0'})
        with urllib.request.urlopen(req, timeout=300) as response:
            total_size = int(response.headers.get('Content-Length', 0))
            downloaded = 0
            
            with open(update_zip, 'wb') as f:
                while True:
                    chunk = response.read(16384)
                    if not chunk:
                        break
                    f.write(chunk)
                    downloaded += len(chunk)
                    if total_size > 0 and progress_callback:
                        progress = int((downloaded / total_size) * 100)
                        progress_callback(progress)
        
        # Распаковываем
        extract_dir = os.path.join(temp_dir, "extracted")
        os.makedirs(extract_dir, exist_ok=True)
        
        with zipfile.ZipFile(update_zip, 'r') as zf:
            zf.extractall(extract_dir)
        
        return extract_dir
    
    except Exception as e:
        print(f"Ошибка скачивания: {e}")
        return None

def apply_update(extract_dir, current_exe_path):
    """Применяет обновление, заменяя текущий EXE"""
    try:
        # Ищем новый EXE в распакованной папке
        new_exe = None
        for root, dirs, files in os.walk(extract_dir):
            for file in files:
                if file.endswith(".exe") and "alauncher" in file.lower():
                    new_exe = os.path.join(root, file)
                    break
            if new_exe:
                break
        
        if not new_exe:
            return False
        
        # Создаём батник для замены файла
        updater_bat = os.path.join(os.path.dirname(current_exe_path), "updater.bat")
        with open(updater_bat, 'w') as f:
            f.write(f"""@echo off
timeout /t 2 /nobreak >nul
move /y "{new_exe}" "{current_exe_path}"
start "" "{current_exe_path}"
del "%~f0"
""")
        
        # Запускаем батник и выходим
        subprocess.Popen(updater_bat, shell=True)
        return True
    
    except Exception as e:
        print(f"Ошибка применения обновления: {e}")
        return False
